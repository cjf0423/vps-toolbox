   {
    "id": "meituan",
    "name": "美团",
    "keys": ["meituanCookie", "meituanDrawKeyword", "meituanPosition"],
    "descs_html": [
      "<h4 align=\"center\">获取Cookie以及脚本配置请查看<a href=\"https://raw.githubusercontent.com/leafTheFish/DeathNote/main/meituan.js\">脚本注释</a></h4>"
    ],
    "settings": [{
          "id": "meituanNotify", 
          "val": "1", 
          "name": "推送开关", 
          "type": "radios", 
          "desc": "默认开启", 
          "items": [
            {
              "key": "1", 
              "label": "开启"
            }, 
            {
              "key": "0", 
              "label": "关闭"
            }
          ]
        }, {
      "id": "meituanCookie",
      "name": "美团cookie",
      "val": "",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "把*.meituan.com包里的userId(可选，用于区别多账号捉包),token填到meituanCookie里，多账号换行或者@隔开。格式：export meituanCookie='userId=12345678&token=ccccccccccccccccc'userId可以删掉不填"
    }, {
      "id": "meituanDrawKeyword",
      "name": "抽奖",
      "val": "",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "要跑小程序抽奖的，把想抽奖的关键词填到变量meituanDrawKeyword里，多个关键词用&连起来。填.*可以抽所有"
    }, {
      "id": "meituanPosition",
      "name": "虚拟定位",
      "val": "113233330,23166670",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "默认虚拟定位广州，需要改的自己把经纬度填到meituanPosition里，注意长度：export meituanPosition='113233330,23166670'"
    }],
    "script": "https://raw.githubusercontent.com/leafTheFish/DeathNote/main/meituan.js",
    "author": "@cjf0423",
    "repo": "https://raw.githubusercontent.com/leafTheFish/DeathNote/main/meituan.js",
    "icons": ["https://raw.githubusercontent.com/Orz-3/mini/master/Color/meituan.png",
        "https://raw.githubusercontent.com/Orz-3/mini/master/Color/meituan.png"]
  },
  {
    "id": "elmleaf",
    "name": "饿了么leaf",
    "keys": ["elmCookie", "elmOrderFlag", "elmScanConcurrency", "elmOrderAmount", "elmOrderTime"],
    "descs_html": [
      "<h4 align=\"center\">获取Cookie以及脚本配置请查看<a href=\"https://raw.githubusercontent.com/leafTheFish/DeathNote/main/elm.js\">脚本注释</a></h4>"
    ],
    "settings": [{
      "id": "elmOrderFlag",
      "name": "兑换优惠券",
      "val": "",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "要抢10元无门槛券的话，设置elmOrderFlag为1，每个账号单独设置并用&隔开，如:export elmOrderFlag='1&0&0'，这样设置为账号1抢兑10元无门槛券，其他账号不抢"
    }, {
      "id": "elmCookie",
      "name": "饿了吗cookie",
      "val": "",
      "type": "textarea",
      "placeholder": "(点击以展开说明)",
      "desc": "饿了么app 或 支付宝饿了么小程序 或 微信饿了么小程序 -> 我的 -> 赚吃货豆h5.ele.me，把header里面的Cookie填进去elmCookie捉包里的Cookie全部内容，如果需要抢券，可以在对应的cookie后面加 orderFlag=1"
    }, {
          "id": "elmScanTask", 
          "val": "0", 
          "name": "扫描吃货豆任务开关", 
          "type": "radios", 
          "desc": "开启的话会使用账号1(不要把黑号放账号1)扫描所有吃货豆任务，但耗时较长(我机器大概需要7分钟)，关闭的话用内置任务列表完成隐藏任务。默认为关闭", 
          "items": [
            {
              "key": "1", 
              "label": "开启"
            }, 
            {
              "key": "0", 
              "label": "关闭"
            }
          ]
        },
    {
      "id": "elmScanConcurrency",
      "name": "扫描吃货豆并发搜索任务数",
      "val": "16",
      "type": "number",
      "placeholder": "(点击以展开说明)",
      "desc": "并发越多搜索越快。但是并发过多可能会丢包变卡，机器性能差的填少一点。默认为16"
    }, {
      "id": "elmOrderAmount",
      "name": "抢券金额",
      "val": "",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "可选，抢券金额，默认为10元。目前只支持9元和10元，每个账号独立，多账号用&隔开。例如 10&9&10 为账号1和3抢10元券，账号2抢9元券"
    }, {
          "id": "elmNotify",
          "name": "推送通知等级",
          "val": "2",
          "type": "selects",
          "items": [
            {
              "key": "0",
              "label": "只有CK失效时候会推送"
            },
            {
              "key": "1",
              "label": "CK失效或者抢到10元券才会推送"
            },
            {
              "key": "2",
              "label": "正常推送"
            }
          ],
          "desc": "默认正常推送"
        }, {
      "id": "elmOrderTime",
      "name": "延迟",
      "val": "9:59:59:850",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "需要在设置的抢券时间提前1分钟跑，默认9:59:59:950开始抢，连续抢50次(大约0.5秒)可以自己配置开始抢券的时间，把elmOrderTime设置成开始的时间，格式(小时:分钟:秒:毫秒)，注意要用英文冒号，如export elmOrderTime=9:59:59:950"
    }],
    "script": "https://raw.githubusercontent.com/leafTheFish/DeathNote/main/elm.js",
    "author": "@cjf0423",
    "repo": "https://raw.githubusercontent.com/leafTheFish/DeathNote/main/elm.js",
    "icons": ["https://raw.githubusercontent.com/Orz-3/mini/master/elem.png",
        "https://raw.githubusercontent.com/Orz-3/task/master/elem.png"]
  }, 
  {
    "id": "bitfinex-lending",
    "name": "Bitfinex 自动放贷",
    "keys": ["bfx_api_key", "bfx_api_secret", "bfx_symbol", "bfx_use_frr", "bfx_frr_offset_pct_day", "bfx_fixed_rate_pct_day", "bfx_period", "bfx_reserve_amount", "bfx_min_offer", "bfx_rate_change_threshold_pct_day", "bfx_amount_change_threshold", "bfx_min_annual_rate", "bfx_dry_run", "bfx_debug"],
    "descs_html": [
      "Bitfinex USD 自动放贷脚本，支持 FRR 浮动利率和固定利率模式"
    ],
    "settings": [{
      "id": "bfx_api_key",
      "name": "API Key",
      "val": "",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "Bitfinex API Key（需要 Funding 读写权限）"
    }, {
      "id": "bfx_api_secret",
      "name": "API Secret",
      "val": "",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "Bitfinex API Secret"
    }, {
      "id": "bfx_symbol",
      "name": "放贷币种",
      "val": "fUSD",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "fUSD, fBTC, fETH, fUSTF0"
    }, {
      "id": "bfx_use_frr",
      "name": "使用 FRR 模式",
      "val": "true",
      "type": "boolean",
      "placeholder": "(点击以展开说明)",
      "desc": "是否使用 FRR 模式，默认 是"
    }, {
      "id": "bfx_frr_offset_pct_day",
      "name": "FRR 偏移值（%/天）",
      "val": "0",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "0=纯FRR  -0.001=低于FRR(LIMIT单)  +0.002=高于FRR(FRRDELTAVAR单)"
    }, {
      "id": "bfx_fixed_rate_pct_day",
      "name": "固定日利率（%/天）",
      "val": "0.018",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "USE_FRR 关闭时生效，0.018 表示 0.018%/天（年化约 6.57%）"
    }, {
      "id": "bfx_period",
      "name": "挂单天数",
      "val": "2",
      "type": "number",
      "placeholder": "(点击以展开说明)",
      "desc": "放贷期限，最小 2 天，最大 120 天"
    }, {
      "id": "bfx_reserve_amount",
      "name": "预留资金（USD）",
      "val": "0",
      "type": "number",
      "placeholder": "(点击以展开说明)",
      "desc": "该金额不参与放贷，始终保留在钱包中"
    }, {
      "id": "bfx_min_offer",
      "name": "最低放贷金额（USD）",
      "val": "150",
      "type": "number",
      "placeholder": "(点击以展开说明)",
      "desc": "可放贷金额低于此值时跳过，Bitfinex 最低要求 150 USD"
    }, {
      "id": "bfx_rate_change_threshold_pct_day",
      "name": "FRR 变动阈值（%/天）",
      "val": "0.002",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "仅负偏移 LIMIT 模式有效，FRR 变动超过此值才撤单重挂"
    }, {
      "id": "bfx_amount_change_threshold",
      "name": "金额变动阈值",
      "val": "1",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "检查本次挂单是否和上次挂单差的金额，当超过设置的阈值才会撤单重挂，否则跳过"
    }, {
      "id": "bfx_min_annual_rate",
      "name": "允许最低年化",
      "val": "0",
      "type": "text",
      "placeholder": "(点击以展开说明)",
      "desc": "允许接受的最低年化收益，如设置为0.10即最低接受10%的年化收益率，当识别frr低于10%会自动跳过。默认0不限制"
    }, {
      "id": "bfx_dry_run",
      "name": "测试模式（不下单）",
      "val": "false",
      "type": "boolean",
      "placeholder": "(点击以展开说明)",
      "desc": "开启后只发通知不实际下单，用于调试"
    }, {
      "id": "bfx_debug",
      "name": "Debug模式",
      "val": "false",
      "type": "boolean",
      "placeholder": "(点击以展开说明)",
      "desc": "开启Debug模式，用于调试"
    }],
    "script": "https://raw.githubusercontent.com/cjf0423/QuantumultX/refs/heads/master/script/Scheduled%20Tasks/bitfinex_lending.js",
    "author": "@cjf0423",
    "repo": "https://raw.githubusercontent.com/cjf0423/QuantumultX/refs/heads/master/script/Scheduled%20Tasks/bitfinex_lending.jss",
    "icons": ["https://raw.githubusercontent.com/cjf0423/QuantumultX/master/icon/Bitfinex.png",
        "https://raw.githubusercontent.com/cjf0423/QuantumultX/master/icon/Bitfinex.png"]
  }, 
  {
  "id": "railgun.checkin.exchange",
  "name": "Railgun 签到兑换",
  "author": "小H for 小锋",
  "repo": "https://github.com/Devilstore/Glados-Railgun-checkin",
  "icons": [
    "https://raw.githubusercontent.com/Orz-3/mini/master/Color/glados.png",
    "https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/glados.png"
  ],
  "keys": [
    "railgun_cookie",
    "railgun_domain",
    "railgun_exchange_enable",
    "railgun_exchange_plan",
    "railgun_verbose",
    "railgun_notify_enable"
  ],
  "settings": [
    {
      "id": "railgun_cookie",
      "name": "Railgun Cookie",
      "val": "",
      "type": "textarea",
      "desc": "必填。填写 railgun.info 或 glados.cloud 的 Cookie。多账号用 & 分隔，例如 cookie1&cookie2。"
    },
    {
      "id": "railgun_domain",
      "name": "运行域名",
      "val": "railgun.info",
      "type": "text",
      "desc": "默认 railgun.info。可填 glados.cloud。多域名用 & 或英文逗号分隔，例如 railgun.info&glados.cloud。"
    },
    {
      "id": "railgun_exchange_enable",
      "name": "启用积分兑换",
      "val": "false",
      "type": "boolean",
      "desc": "是否自动兑换积分。默认关闭，开启后积分达到套餐要求会自动兑换。"
    },
    {
      "id": "railgun_exchange_plan",
      "name": "兑换套餐",
      "val": "plan500",
      "type": "selects",
      "items": [
        { "key": "plan100", "label": "plan100 - 100积分 / 约10天" },
        { "key": "plan200", "label": "plan200 - 200积分 / 约30天" },
        { "key": "plan500", "label": "plan500 - 500积分 / 约100天" }
      ],
      "desc": "兑换接口参数 planType。默认 plan500。"
    },
    {
      "id": "railgun_notify_enable",
      "name": "启用运行结果通知",
      "val": "true",
      "type": "boolean",
      "desc": "默认开启。Surge/QuanX 会弹窗通知；青龙会尝试调用 sendNotify.js。"
    },
    {
      "id": "railgun_verbose",
      "name": "详细日志",
      "val": "false",
      "type": "boolean",
      "desc": "开启后输出接口响应前 500 字符，便于排查问题。"
    }
  ],
  "scripts": [
    {
      "name": "Railgun 签到兑换",
      "script": "railgun_checkin_exchange_boxjs.js",
      "argument": "",
      "timeout": 60,
      "type": "cron",
      "cron": "10 9 * * *",
      "desc": "每日签到、查询天数/积分，可选自动兑换，并通知运行结果。"
    },
    {
      "name": "Railgun 获取 Cookie",
      "script": "railgun_checkin_exchange_boxjs.js",
      "type": "http-request",
      "pattern": "^https?:\\/\\/(railgun\\.info|glados\\.(cloud|space))\\/",
      "desc": "访问 railgun.info 或 glados.cloud 时抓取 Cookie，保存到 railgun_cookie。抓取成功后建议禁用该抓包规则。"
    }
  ],
  "description": "Railgun/GLaDOS 签到、状态查询、积分查询和可选自动兑换。v3 增加运行结果通知：Surge/QuanX 弹窗，青龙 sendNotify。"
  },
